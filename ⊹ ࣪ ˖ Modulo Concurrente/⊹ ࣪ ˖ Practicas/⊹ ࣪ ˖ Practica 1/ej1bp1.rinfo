programa P1ej1b
{ ENUNCIADO - Practica 1, Ejercicio 1 b) (2026):
  Modifique el programa anterior para que el trabajo sea realizado por 3
  robots: uno realiza la avenida 1, otro realiza la avenida 3 y otro la
  avenida 5. Cada robot debe iniciar en las esquina (1,1), (3,1) y (5,1)
  respectivamente. }

{ RESOLUCION:
  - Los 3 robots hacen EXACTAMENTE la misma tarea, solo cambia donde estan:
    se declara UN tipo de robot y TRES variables de ese tipo.
  - Cada avenida es un AreaP de un solo robot. Como los recorridos no se
    tocan, no hay riesgo de colision: no se bloquea nada.
  - Los 3 trabajan en paralelo (concurrencia real) y no se comunican. }
procesos
  proceso procesarEsquina(ES flores: numero; ES vacias: numero)
  { Junta las flores de la esquina; si no habia ninguna, cuenta la esquina vacia. }
  comenzar
    si (HayFlorEnLaEsquina)
      mientras (HayFlorEnLaEsquina)
        tomarFlor
        flores := flores + 1
    sino
      vacias := vacias + 1
  fin
  proceso recorrerAvenida(ES flores: numero; ES vacias: numero)
  comenzar
    repetir 99
      procesarEsquina(flores, vacias)
      mover
    procesarEsquina(flores, vacias)
  fin
  proceso depositarFlores(E cant: numero)
  comenzar
    repetir cant
      depositarFlor
  fin
  proceso hacerAvenida
  variables
    flores, vacias: numero
  comenzar
    flores := 0
    vacias := 0
    recorrerAvenida(flores, vacias)
    depositarFlores(flores)
    Informar('FloresDepositadas', flores)
    Informar('EsquinasSinFlores', vacias)
  fin
areas
  avenida1: AreaP(1,1,1,100)
  avenida3: AreaP(3,1,3,100)
  avenida5: AreaP(5,1,5,100)
robots
  robot florero
  comenzar
    hacerAvenida
  fin
variables
  r1, r2, r3: florero
comenzar
  AsignarArea(r1, avenida1)
  AsignarArea(r2, avenida3)
  AsignarArea(r3, avenida5)
  Iniciar(r1, 1, 1)
  Iniciar(r2, 3, 1)
  Iniciar(r3, 5, 1)
fin