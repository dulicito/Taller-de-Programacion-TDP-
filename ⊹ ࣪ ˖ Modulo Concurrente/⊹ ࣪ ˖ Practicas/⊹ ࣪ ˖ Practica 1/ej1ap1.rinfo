programa P1ej1a
{ ENUNCIADO - Practica 1, Ejercicio 1 a) (2026):
  Modifique el programa anterior para que el mismo robot realice lo mismo
  en las avenidas 1, 3 y 5. }

{ RESOLUCION:
  - Sigue siendo UN robot, pero ahora con TRES areas privadas (una por
    avenida). Un robot puede tener varias areas asignadas, y cada AreaP
    tiene un solo robot, asi que es correcto.
  - El trabajo de "una avenida" se encapsula en el proceso hacerAvenida,
    que inicializa sus propios contadores e informa al terminar.
  - Entre avenida y avenida el robot salta con Pos a la calle 1 de la
    siguiente (Pos no cambia la orientacion: sigue mirando al norte). }
procesos
  proceso procesarEsquina(ES flores: numero; ES vacias: numero)
  { Junta las flores de la esquina; si no habia ninguna, cuenta la esquina vacia. }
  comenzar
    si (HayFlorEnLaEsquina)
      mientras (HayFlorEnLaEsquina)
        tomarFlor
        flores := flores + 1
    sino
      vacias := vacias + 1
  fin
  proceso recorrerAvenida(ES flores: numero; ES vacias: numero)
  { 100 esquinas: 99 (procesar + mover) y la ultima fuera del repetir. }
  comenzar
    repetir 99
      procesarEsquina(flores, vacias)
      mover
    procesarEsquina(flores, vacias)
  fin
  proceso depositarFlores(E cant: numero)
  comenzar
    repetir cant
      depositarFlor
  fin
  proceso hacerAvenida
  { Tarea completa sobre la avenida actual: recorrer, depositar al final e
    informar. Usa variables locales, asi cada avenida informa sus propios valores. }
  variables
    flores, vacias: numero
  comenzar
    flores := 0
    vacias := 0
    recorrerAvenida(flores, vacias)
    depositarFlores(flores)
    Informar('FloresDepositadas', flores)
    Informar('EsquinasSinFlores', vacias)
  fin
areas
  avenida1: AreaP(1,1,1,100)
  avenida3: AreaP(3,1,3,100)
  avenida5: AreaP(5,1,5,100)
robots
  robot florero
  variables
    av: numero
  comenzar
    av := PosAv              { empieza en la avenida 1 }
    hacerAvenida
    repetir 2
      av := av + 2           { 3 y despues 5 }
      Pos(av, 1)
      hacerAvenida
  fin
variables
  r1: florero
comenzar
  AsignarArea(r1, avenida1)
  AsignarArea(r1, avenida3)
  AsignarArea(r1, avenida5)
  Iniciar(r1, 1, 1)
fin